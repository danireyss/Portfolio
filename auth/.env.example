# Copy to auth/.env for `make dev` (it's gitignored). In production these come from SSM
# Parameter Store instead (/portfolio/auth/*).

# Google Cloud Console -> APIs & Services -> Credentials -> your OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs and encrypts the session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The only Google account allowed into admin. `make dev` passes it to the API too.
ADMIN_EMAIL=

# Where the site runs in development; Google sends you back here after signing in.
BETTER_AUTH_URL=http://localhost:5173
